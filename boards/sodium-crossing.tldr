k", "attrs": {"href": "https://commons.wikimedia.org/wiki/File:Ferdamat_snacks_and_coffee_vending_machines_in_Fanafjord_ferry,_Hordaland,_Norway,_2018-03-05_IMG_5587.jpg", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:OgDOQcl7yAxRTOyJFl67W", "typeName": "shape", "type": "image", "x": 980.0, "y": 60.0, "rotation": 0, "index": "b2K", "parentId": "shape:BBVZDlz3zOICJpI1ew28a", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 280.35, "playing": true, "url": "https://commons.wikimedia.org/wiki/File:Waiting_room_at_Belmont_ferry_terminal_at_night_-_geograph.org.uk_-_2626996.jpg", "assetId": "asset:8396pYLm9OYIe1kqMmCSf", "crop": null, "flipX": false, "flipY": false, "altText": "Found set #3: lit ferry waiting room at night, Belmont, Shetland — a box stage."}, "meta": {}}, {"id": "shape:9C0oUS6Z2qWDtwX00PkjJ", "typeName": "shape", "type": "text", "x": 980.0, "y": 348.35, "rotation": 0, "index": "b2L", "parentId": "shape:BBVZDlz3zOICJpI1ew28a", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Found set #3: lit ferry waiting room at night, Belmont, Shetland — a box stage."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Mike Pennington · CC BY-SA 2.0 · via Wikimedia Commons"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Source: "}, {"type": "text", "text": "https://commons.wikimedia.org/wiki/File:Waiting_room_at_Belmont_ferry_terminal_at_night_-_geograph.org.uk_-_2626996.jpg", "marks": [{"type": "link", "attrs": {"href": "https://commons.wikimedia.org/wiki/File:Waiting_room_at_Belmont_ferry_terminal_at_night_-_geograph.org.uk_-_2626996.jpg", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:nugjSn0u0sqyaBxa1xa7o", "typeName": "shape", "type": "geo", "x": 980.0, "y": 552.1500000000001, "rotation": 0, "index": "b2M", "parentId": "shape:BBVZDlz3zOICJpI1ew28a", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://www.spiegel.de/kultur/gesellschaft/die-buehnenbilder-der-anna-viebrock-ranzige-treppe-ins-nichts-a-778001.html", "w": 420.0, "h": 303.0, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Anna Viebrock — 'inventing what one finds'", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Christoph Marthaler's designer builds institutional public spaces — waiting rooms, foyers, aircraft cabins — with dark wood panelling, linoleum and fluorescent light. Method: Das Vorgefundene erfinden."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://www.spiegel.de/kultur/gesellschaft/die-buehnenbilder-der-anna-viebrock-ranzige-treppe-ins-nichts-a-778001.html", "marks": [{"type": "link", "attrs": {"href": "https://www.spiegel.de/kultur/gesellschaft/die-buehnenbilder-der-anna-viebrock-ranzige-treppe-ins-nichts-a-778001.html", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:pbgSKFpr8x92h0bSYRIYj", "typeName": "shape", "type": "geo", "x": 60.0, "y": 582.6, "rotation": 0, "index": "b2N", "parentId": "shape:BBVZDlz3zOICJpI1ew28a", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://en.wikipedia.org/wiki/Christoph_Marthaler", "w": 420.0, "h": 205.8, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Christoph Marthaler", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Swiss director-musician: slow, choral, melancholy-comic stagings of people stuck in waiting spaces."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://en.wikipedia.org/wiki/Christoph_Marthaler", "marks": [{"type": "link", "attrs": {"href": "https://en.wikipedia.org/wiki/Christoph_Marthaler", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:HqylRJWML5YJu5xguR5OP", "typeName": "shape", "type": "geo", "x": 520.0, "y": 586.8, "rotation": 0, "index": "b2O", "parentId": "shape:BBVZDlz3zOICJpI1ew28a", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://www.rimini-protokoll.de/website/en/project/cargo-sofia-x", "w": 420.0, "h": 278.70000000000005, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rimini Protokoll — Cargo Sofia (Stefan Kaegi)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "~45 spectators ride a converted Bulgarian truck with a glass side for 90–120 min through transit zones and border checkpoints. Model for an immersive 'crossing' activation."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://www.rimini-protokoll.de/website/en/project/cargo-sofia-x", "marks": [{"type": "link", "attrs": {"href": "https://www.rimini-protokoll.de/website/en/project/cargo-sofia-x", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:6WBCVtgMYpQ3hiEu69BXN", "typeName": "shape", "type": "geo", "x": 60.0, "y": 828.4000000000001, "rotation": 0, "index": "b2P", "parentId": "shape:BBVZDlz3zOICJpI1ew28a", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 205.8, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "orange", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Staging brief", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Set rule: build the cafeteria at 1:1 with one row of lights on; a working (or dead) vending machine as the only practical; floor tilted 1–2° so props creep. Scene changes happen as PA announcements."}]}]}}, "meta": {}}, {"id": "shape:k8keCbDz7z0WKosEyOFuL", "typeName": "shape", "type": "frame", "x": 1620.0, "y": 8242.954523700875, "rotation": 0, "index": "b2Q", "parentId": "page:moodboard", "isLocked": false, "opacity": 1, "props": {"w": 1460.0, "h": 1375.3000000000002, "name": "Fine Art & Photography", "color": "black"}, "meta": {"zone": "Fine Art & Photography"}}, {"id": "shape:zgTXLhL29Vc2Pr5Z3pJxs", "typeName": "shape", "type": "image", "x": 60.0, "y": 60.0, "rotation": 0, "index": "b2R", "parentId": "shape:k8keCbDz7z0WKosEyOFuL", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 267.12, "playing": true, "url": "https://commons.wikimedia.org/wiki/File:John_Atkinson_Grimshaw_(1836-1893)_-_Liverpool_Docks_by_Night_-_WAG_10328_-_Walker_Art_Gallery.jpg", "assetId": "asset:9muafdAZR7ZKJaxqMeHxE", "crop": null, "flipX": false, "flipY": false, "altText": "John Atkinson Grimshaw, Liverpool Docks by Night, 1892: gas-lit wet quays, the Victorian sodium."}, "meta": {}}, {"id": "shape:VMuH5J4J9bCIT8MDNHR6a", "typeName": "shape", "type": "text", "x": 60.0, "y": 335.12, "rotation": 0, "index": "b2S", "parentId": "shape:k8keCbDz7