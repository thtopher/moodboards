"image", "x": 980.0, "y": 60.0, "rotation": 0, "index": "b1m", "parentId": "shape:uyLWqwyw4HruYjQbldXjo", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 340.8, "playing": true, "url": "https://commons.wikimedia.org/wiki/File:Star_Ferry_crew_using_billhook_to_catch_rope_at_Central_ferry_pier,_Hong_Kong.jpg", "assetId": "asset:w569AJYVC1y6DhUiQd9HT", "crop": null, "flipX": false, "flipY": false, "altText": "Star Ferry crew mooring with a billhook, Hong Kong (2013): sailor whites, work gloves, rope."}, "meta": {}}, {"id": "shape:lFuk5DWp4n4L8VNH0Bg4X", "typeName": "shape", "type": "text", "x": 980.0, "y": 408.8, "rotation": 0, "index": "b1n", "parentId": "shape:uyLWqwyw4HruYjQbldXjo", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Star Ferry crew mooring with a billhook, Hong Kong (2013): sailor whites, work gloves, rope."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Daniel Case · CC BY-SA 3.0 · via Wikimedia Commons"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Source: "}, {"type": "text", "text": "https://commons.wikimedia.org/wiki/File:Star_Ferry_crew_using_billhook_to_catch_rope_at_Central_ferry_pier,_Hong_Kong.jpg", "marks": [{"type": "link", "attrs": {"href": "https://commons.wikimedia.org/wiki/File:Star_Ferry_crew_using_billhook_to_catch_rope_at_Central_ferry_pier,_Hong_Kong.jpg", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:QUoCZ75jQIzkiDEqwIVKk", "typeName": "shape", "type": "geo", "x": 60.0, "y": 584.4000000000001, "rotation": 0, "index": "b1o", "parentId": "shape:uyLWqwyw4HruYjQbldXjo", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://www.hellyhansen.com/about-us/heritage", "w": 420.0, "h": 254.4, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Helly Hansen — oilskins since 1877", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Founded 1877 in Moss, Norway by sea captain Helly Juell Hansen and Maren Margarethe, who made linseed-oil-soaked oilskins; awarded at the 1878 Paris exhibition. Crew-deck outerwear DNA."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://www.hellyhansen.com/about-us/heritage", "marks": [{"type": "link", "attrs": {"href": "https://www.hellyhansen.com/about-us/heritage", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:2w78iK7xHtbmhrNI6Qw6N", "typeName": "shape", "type": "geo", "x": 520.0, "y": 602.7455587392551, "rotation": 0, "index": "b1p", "parentId": "shape:uyLWqwyw4HruYjQbldXjo", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://www.monclergroup.com/en/brands/stone-island/history", "w": 420.0, "h": 254.4, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stone Island — Tela Stella, 1982", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Massimo Osti built the first collection from truck-tarpaulin canvas (Tela Stella); the nautical Marina line followed. Industrial cloth as fashion — the ferry-terminal lad on the 3am deck."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://www.monclergroup.com/en/brands/stone-island/history", "marks": [{"type": "link", "attrs": {"href": "https://www.monclergroup.com/en/brands/stone-island/history", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:H1PwLs8p8daImFhZPQ59Q", "typeName": "shape", "type": "geo", "x": 980.0, "y": 636.9000000000001, "rotation": 0, "index": "b1q", "parentId": "shape:uyLWqwyw4HruYjQbldXjo", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://heronpreston.com/pages/led_upcycled/dsny", "w": 420.0, "h": 205.8, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Heron Preston — UNIFORM for DSNY (2016)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Upcycled New York sanitation uniforms: hi-vis and municipal workwear as luxury. Template for reworking ferry crew kit."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://heronpreston.com/pages/led_upcycled/dsny", "marks": [{"type": "link", "attrs": {"href": "https://heronpreston.com/pages/led_upcycled/dsny", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:SadA8tJaz3KZamlZg5q2F", "typeName": "shape", "type": "geo", "x": 60.0, "y": 878.8000000000001, "rotation": 0, "index": "b1r", "parentId": "shape:uyLWqwyw4HruYjQbldXjo", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "http://craig-green.com/", "w": 420.0, "h": 181.5, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Craig Green — workwear and uniform, reworked", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Quilted, strapped, utilitarian garments; studio in London's Docklands."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "http://craig-green.com/", "marks": [{"type": "link", "attrs": {"href": "http://craig-green.com/", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:u7zReZ8gUqjwP799MOjTI", "typeName": "shape", "type": "geo", "x": 980.0, "y": 882.7, "rotation": 0, "index": "b1s", "parentId": "shape:uyLWqwyw4HruYjQbldXjo", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 254.4, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Costume brief", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Wardrobe rules: crew in navy wool-blend, white shirt with epaulettes, hi-vis over-vest on the car deck, orange lifejacket as the only saturated garment. Passengers in what they slept in: fleece, travel pillow, lorry-driver's quilted gilet, duty-free carrier bag as accessory."}]}]}}, "meta": {}}, {"id": "shape:w3pijjKXjFJIzHadAoUoZ", "typeName": "shape", "type": "frame", "x": 3700.0, "y": 6077.233277107163, "rotation": 0, "index": "b1t", "parentId": "page:moodboard", "isLocked": false, "opacity": 1, "props": {"w": 1460.0, "h": 1965.721246593711, "name": "Film & Moving Image", "color": "black"}, "meta": {"zone": "Film & Moving Image"}}, {"id": "shape:ofDyuVnPZCF5LlefufOAt", "typeName": "shape", "type": "text", "x": 60.0, "y": 60.0, "rotation": 0, "index": "b1u", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"color": "grey", "size": "s", "font": "sans", "textAlign": "start", "w": 1340.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames extracted with ffmpeg from 1982/1988 Sealink TV adverts on the Internet Archive (timestamps in captions), plus film references as links."}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:SFkPAOf3anymfQ9uqPnyQ", "typeName": "shape", "type": "image", "x": 60.0, "y": 112.3, "rotation": 0, "index": "b1v", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 236.0655737704918, "playing": true, "url": "https://archive.org/details/british-rail-sealink-claire-francis", "assetId": "asset:F6pjsu4RAkch0OjMdFugU", "crop": null, "flipX": false, "flipY": false, "altText": "Sealink (British Rail) TV advert, 1982, at ~0:02 — yachtswoman Clare Francis MBE in red foul-weather gear: the brand borrows the sea's heroism."}, "meta": {}}, {"id": "shape:AjeH95gFEmPEYs5YDiDhQ", "typeName": "shape", "type": "text", "x": 60.0, "y": 356.3655737704918, "rotation": 0, "index": "b1w", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sealink (British Rail) TV advert, 1982, at ~0:02 — yachtswoman Clare Francis MBE in red foul-weather gear: the brand borrows the sea's heroism."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "British Rail / Sealink, 1982 · Internet Archive (rights not stated; reference only)"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Source: "}, {"type": "text", "text": "https://archive.org/details/british-rail-sealink-claire-francis", "marks": [{"type": "link", "attrs": {"href": "https://archive.org/details/british-rail-sealink-claire-francis", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:1Nj2ShxPacv29t4W1K8N6", "typeName": "shape", "type": "image", "x": 520.0, "y": 112.3, "rotation": 0, "index": "b1x", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 236.0655737704918, "playing": true, "url": "https://archive.org/details/british-rail-sealink-claire-francis", "assetId": "asset:RJ8cSXgtdKSvRwSr8BafT", "crop": null, "flipX": false, "flipY": false, "altText": "Same advert, ~0:12 — the SEALINK hull wordmark sliding past a sail. Scale contrast: ferry as moving wall."}, "meta": {}}, {"id": "shape:JmGDuxFKnrFFzPlGrVRWG", "typeName": "shape", "type": "text", "x": 520.0, "y": 356.3655737704918, "rotation": 0, "index": "b1y", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Same advert, ~0:12 — the SEALINK hull wordmark sliding past a sail. Scale contrast: ferry as moving wall."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "British Rail / Sealink, 1982 · Internet Archive (rights not stated; reference only)"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Source: "}, {"type": "text", "text": "https://archive.org/details/british-rail-sealink-claire-francis", "marks": [{"type": "link", "attrs": {"href": "https://archive.org/details/british-rail-sealink-claire-francis", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:PNQqdwc7GP7XougXTEwqE", "typeName": "shape", "type": "image", "x": 980.0, "y": 112.3, "rotation": 0, "index": "b1z", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 236.0655737