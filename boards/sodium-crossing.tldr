, "rotation": 0, "index": "b36", "parentId": "shape:TPmHLTmtvfvTJkThUjfpF", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://archive.org/details/aporee_2557_3549", "w": 420.0, "h": 205.8, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "radio aporee — 'baltic sea, night ferry, ventilation shaft on deck' (Dirk Raulf)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Trelleborg–Travemünde night ferry, Aug 2008; CC BY-SA 3.0."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://archive.org/details/aporee_2557_3549", "marks": [{"type": "link", "attrs": {"href": "https://archive.org/details/aporee_2557_3549", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:dGsPILsTQSDCrcCMl120Y", "typeName": "shape", "type": "geo", "x": 1440.0, "y": 1562.8, "rotation": 0, "index": "b37", "parentId": "shape:TPmHLTmtvfvTJkThUjfpF", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://archive.org/details/aporee_2545_3535", "w": 420.0, "h": 205.8, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "radio aporee — 'ferry, cardeck' (Dirk Raulf)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Travemünde–Trelleborg night ferry, July 2008; CC BY-SA 3.0."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://archive.org/details/aporee_2545_3535", "marks": [{"type": "link", "attrs": {"href": "https://archive.org/details/aporee_2545_3535", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:EkqT9gavvLg0u4usk7KZd", "typeName": "shape", "type": "geo", "x": 980.0, "y": 1757.2000000000003, "rotation": 0, "index": "b38", "parentId": "shape:TPmHLTmtvfvTJkThUjfpF", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://archive.org/details/aporee_58144_66667", "w": 420.0, "h": 230.10000000000002, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "radio aporee — 'Stena Line, North Sea - cabin walk' (Sophie Standford)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Recorded with electromagnetic-field microphones: the ship's hidden electrical hum. CC BY-SA 3.0."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://archive.org/details/aporee_58144_66667", "marks": [{"type": "link", "attrs": {"href": "https://archive.org/details/aporee_58144_66667", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:HT86gx9H7pb6qIwJ562pY", "typeName": "shape", "type": "frame", "x": 0.0, "y": 10510.254523700874, "rotation": 0, "index": "b39", "parentId": "page:moodboard", "isLocked": false, "opacity": 1, "props": {"w": 1460.0, "h": 1013.0999999999999, "name": "Voice & Copy", "color": "black"}, "meta": {"zone": "Voice & Copy"}}, {"id": "shape:bz6pwKoROf5eRvie9XCX8", "typeName": "shape", "type": "geo", "x": 60.0, "y": 60.0, "rotation": 0, "index": "b3A", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 181.5, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rule 1", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Procedural first: write like the PA and the safety card — times, decks, numbers — then let one line of feeling leak through."}]}]}}, "meta": {}}, {"id": "shape:5HrG8TP0zI0m1bHJj5Blz", "typeName": "shape", "type": "geo", "x": 520.0, "y": 60.0, "rotation": 0, "index": "b3B", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 157.2, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rule 2", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Bilingual by default; the second language is a different emotional register, not a translation."}]}]}}, "meta": {}}, {"id": "shape:KAafSipY12kaULwbAoK8m", "typeName": "shape", "type": "geo", "x": 980.0, "y": 60.0, "rotation": 0, "index": "b3C", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rule 3", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Short declaratives. No exclamation marks. Never sell — inform."}]}]}}, "meta": {}}, {"id": "shape:eRgnB9utDkyRuXlgMC4gU", "typeName": "shape", "type": "geo", "x": 980.0, "y": 232.9, "rotation": 0, "index": "b3D", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 157.2, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rule 4", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Name real coordinates (decks, cabins, ports, times); avoid 'journey', 'adventure', 'escape'."}]}]}}, "meta": {}}, {"id": "shape:PwhLVDDQLAlCI39IunNTp", "typeName": "shape", "type": "geo", "x": 520.0, "y": 257.2, "rotation": 0, "index": "b3E", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 157.2, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rule 5", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Tender, not nostalgic: the subject is present-tense loneliness, not a retro postcard."}]}]}}, "meta": {}}, {"id": "shape:Q9y6BO1mv9esDUN5PaecA", "typeName": "shape", "type": "geo", "x": 60.0, "y": 281.5, "rotation": 0, "index": "b3F", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "“You are now in international waters. Nothing has changed except the prices.”"}]}]}}, "meta": {}}, {"id": "shape:bGNm1z7wMHqWapt2FcsLY", "typeName": "shape", "type": "geo", "x": 980.0, "y": 430.1, "rotation": 0, "index": "b3G", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "“The shop closes at 01:00. The sea does not.”"}]}]}}, "meta": {}}, {"id": "shape:gWyGAB944TRicZPNtq5Gb", "typeName": "shape", "type": "geo", "x": 60.0, "y": 454.4, "rotation": 0, "index": "b3H", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "“Car deck 3 is closed for the crossing. Your car will wait for you in the dark.”"}]}]}}, "meta": {}}, {"id": "shape:vve83YazgSYWXhaf0ZGo1", "typeName": "shape", "type": "geo", "x": 520.0, "y": 454.4, "rotation": 0, "index": "b3I", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "“Cabin 7124. Inside. Two berths. No window, no country.”"}]}]}}, "meta": {}}, {"id": "shape:hua8zVXK9W57fUouv9dAh", "typeName": "shape", "type": "geo", "x": 980.0, "y": 603.0, "rotation": 0, "index": "b3J", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "“Please return to your vehicle when the chime sounds twice.”"}]}]}}, "meta": {}}, {"id": "shape:9ERGVuzUR3t0TJzJegthd", "typeName": "shape", "type": "geo", "x": 60.0, "y": 627.3, "rotation": 0, "index": "b3K", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "“Breakfast from 06:00, deck 8. Mariehamn at 04:35, if you are awake.”"}]}]}}, "meta": {}}, {"id": "shape:STMmSZMoJyqj1N5kqFdsH", "typeName": "shape", "type": "geo", "x": 520.0, "y": 627.3, "rotation": 0, "index": "b3L", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "“We will arrive on time. We will arrive somewhere else.”"}]}]}}, "meta": {}}, {"id": "shape:D4JNKWwa8XhgnOibEaqxm", "typeName": "shape", "type": "geo", "x": 980.0, "y": 775.9, "rotation": 0, "index": "b3M", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "“Assembly station No. 1 is here. We hope you never need to know that.”"}]}]}}, "meta": {}}, {"id": "shape:aqpuzwubZTEao3CmY3hFI", "typeName": "shape", "type": "geo", "x": 60.0, "y": 800.1999999999999, "rotation": 0, "index": "b3N", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "“The orange light is the last of its kind. So, probably, is this night.”"}]}]}}, "meta": {}}, {"id": "shape:htMPMMxebZ14eVkvm1YZx", "typeName": "shape", "type": "geo", "x": 520.0, "y": 800.1999999999999, "rotation": 0, "index": "b3O", "parentId": "shape:HT86gx9H7pb6qIwJ562pY", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "b