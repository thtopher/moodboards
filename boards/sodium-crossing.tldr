raph", "content": [{"type": "text", "text": "Period between signals 1m00s."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://sound-effects.bbcrewind.co.uk/07018114", "marks": [{"type": "link", "attrs": {"href": "https://sound-effects.bbcrewind.co.uk/07018114", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:HzIf5giPNYQ5daoWjGVjG", "typeName": "shape", "type": "geo", "x": 1440.0, "y": 1317.0, "rotation": 0, "index": "b33", "parentId": "shape:TPmHLTmtvfvTJkThUjfpF", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://sound-effects.bbcrewind.co.uk/07014011", "w": 420.0, "h": 205.8, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "BBC Sound Effects 07014011 — Cars driving off ferry ramp", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Recorded from inside the car ferry — the disembark crescendo."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://sound-effects.bbcrewind.co.uk/07014011", "marks": [{"type": "link", "attrs": {"href": "https://sound-effects.bbcrewind.co.uk/07014011", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:3UyDr7WQsTEXw2QBIXG7a", "typeName": "shape", "type": "geo", "x": 980.0, "y": 1462.8000000000002, "rotation": 0, "index": "b34", "parentId": "shape:TPmHLTmtvfvTJkThUjfpF", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://freesound.org/people/LG/sounds/55501/", "w": 420.0, "h": 254.4, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", 