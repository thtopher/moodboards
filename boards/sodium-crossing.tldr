otation": 0, "index": "b22", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sealink British Ferries 'Doubletake' advert, 1988, ~0:01 — a telephoto ferry on a flat sea; video-tape blue."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sealink British Ferries, 1988 · Internet Archive (rights not stated; reference only)"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Source: "}, {"type": "text", "text": "https://archive.org/details/SealinkDoubletakeAdvert", "marks": [{"type": "link", "attrs": {"href": "https://archive.org/details/SealinkDoubletakeAdvert", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:2wuMIrf7whOGuu0uz7wyk", "typeName": "shape", "type": "image", "x": 980.0, "y": 560.1655737704918, "rotation": 0, "index": "b23", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 319.155672823219, "playing": true, "url": "https://archive.org/details/SealinkDoubletakeAdvert", "assetId": "asset:B9fCnaffwAFrRF8kFEx1m", "crop": null, "flipX": false, "flipY": false, "altText": "Doubletake, ~0:17 — the end card: italic SEALINK DOUBLETAKE super over the ship, small-print offer terms. Halfway through, the clip rewinds and plays again."}, "meta": {}}, {"id": "shape:PPBzoWCZxTbn7QPEDmkOR", "typeName": "shape", "type": "text", "x": 980.0, "y": 887.3212465937108, "rotation": 0, "index": "b24", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Doubletake, ~0:17 — the end card: italic SEALINK DOUBLETAKE super over the ship, small-print offer terms. Halfway through, the clip rewinds and plays again."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sealink British Ferries, 1988 · Internet Archive (rights not stated; reference only)"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Source: "}, {"type": "text", "text": "https://archive.org/details/SealinkDoubletakeAdvert", "marks": [{"type": "link", "attrs": {"href": "https://archive.org/details/SealinkDoubletakeAdvert", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:qNiMkFtIiDMitQHMWJnBZ", "typeName": "shape", "type": "geo", "x": 60.0, "y": 584.4655737704918, "rotation": 0, "index": "b25", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://en.wikipedia.org/wiki/Drive_My_Car_(film)", "w": 420.0, "h": 254.4, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Drive My Car (Ryusuke Hamaguchi, 2021)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The red Saab 900 travels from Hiroshima to Hokkaido and crosses on an overnight car ferry; the car was red to stand out in Japanese landscapes (sources: sodane.hokkaido.jp; soft99.co.jp)."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://en.wikipedia.org/wiki/Drive_My_Car_(film)", "marks": [{"type": "link", "attrs": {"href": "https://en.wikipedia.org/wiki/Drive_My_Car_(film)", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:JUwB8YOgLc58Tq0kZGa3B", "typeName": "shape", "type": "geo", "x": 60.0, "y": 878.8655737704918, "rotation": 0, "index": "b26", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://www.criterion.com/current/posts/2064-red-a-fraternity-of-strangers", "w": 420.0, "h": 230.10000000000002, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three Colours: Red (Kieślowski, 1994)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Ends with a cross-Channel ferry lost in a storm; seven survivors from the news report's 1,435 passengers, including the barman. The ferry as fate machine."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://www.criterion.com/current/posts/2064-red-a-fraternity-of-strangers", "marks": [{"type": "link", "attrs": {"href": "https://www.criterion.com/current/posts/2064-red-a-fraternity-of-strangers", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:ZQH1m3vbueeMhjsr5419B", "typeName": "shape", "type": "geo", "x": 520.0, "y": 1091.1212465937108, "rotation": 0, "index": "b27", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://en.wikipedia.org/wiki/Leviathan_(2012_film)", "w": 420.0, "h": 230.10000000000002, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Leviathan (Castaing-Taylor & Paravel, 2012)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "GoPro cameras, 20-hour shifts aboard a fishing vessel — the ship's body and noise, not its view."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://en.wikipedia.org/wiki/Leviathan_(2012_film)", "marks": [{"type": "link", "attrs": {"href": "https://en.wikipedia.org/wiki/Leviathan_(2012_film)", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:Xr5YTof5IL1iRCWCm7rUZ", "typeName": "shape", "type": "geo", "x": 980.0, "y": 1115.4212465937107, "rotation": 0, "index": "b28", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://www.theforgottenspace.net/static/info.html", "w": 420.0, "h": 230.10000000000002, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The Forgotten Space (Allan Sekula & Noël Burch, 2010)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "112-min essay film on the sea as forgotten logistics space; based on Sekula's Fish Story."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://www.theforgottenspace.net/static/info.html", "marks": [{"type": "link", "attrs": {"href": "https://www.theforgottenspace.net/static/info.html", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:pRynn7wFFbUU2wnvTOzGj", "typeName": "shape", "type": "geo", "x": 60.0, "y": 1148.9655737704918, "rotation": 0, "index": "b29", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://en.wikipedia.org/wiki/Songs_from_the_Second_Floor", "w": 420.0, "h": 230.10000000000002, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Songs from the Second Floor (Roy Andersson, 2000)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Disconnected tableaux of modern life — reference for staging static, deadpan wide shots in institutional rooms."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://en.wikipedia.org/wiki/Songs_from_the_Second_Floor", "marks": [{"type": "link", "attrs": {"href": "https://en.wikipedia.org/wiki/Songs_from_the_Second_Floor", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:4DFWmSvYfrNDxJnBaXpZI", "typeName": "shape", "type": "geo", "x": 520.0, "y": 1361.221246593711, "rotation": 0, "index": "b2A", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://en.wikipedia.org/wiki/The_Other_Side_of_Hope", "w": 420.0, "h": 254.4, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The Other Side of Hope (Aki Kaurismäki, 2017)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Helsinki; a Syrian asylum-seeker and a Finnish businessman. Kaurismäki's flat, saturated, kind minimalism for the Baltic register."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://en.wikipedia.org/wiki/The_Other_Side_of_Hope", "marks": [{"type": "link", "attrs": {"href": "https://en.wikipedia.org/wiki/The_Other_Side_of_Hope", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:LMhWs1WQYBP7lgzFjn1yj", "typeName": "shape", "type": "geo", "x": 980.0, "y": 1385.5212465937107, "rotation": 0, "index": "b2B", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://en.wikipedia.org/wiki/Fallen_Angels_(1995_film)", "w": 420.0, "h": 205.8, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fallen Angels (Wong Kar-wai, 1995)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Night loneliness and alienation in pre-Handover Hong Kong; wide-angle, neon-soaked night interiors."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://en.wikipedia.org/wiki/Fallen_Angels_(1995_film)", "marks": [{"type": "link", "attrs": {"href": "https://en.wikipedia.org/wiki/Fallen_Angels_(1995_film)", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:lJlDHBFZb5mcVJHnWsToJ", "typeName": "shape", "type": "geo", "x": 60.0, "y": 1419.065573770492, "rotation": 0, "index": "b2C", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://en.wikipedia.org/wiki/Under_the_Skin_(2013_film)", "w": 420.0, "h": 205.8, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Under the Skin (Jonathan Glazer, 2013)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Lone figures in Scottish night; documentary-style concealed cameras inside a fiction."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://en.wikipedia.org/wiki/Under_the_Skin_(2013_film)", "marks": [{"type": "link", "attrs": {"href": "https://en.wikipedia.org/wiki/Under_the_Skin_(2013_film)", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:OxDeNQjITg01dpfpfEpsC", "typeName": "shape", "type": "geo", "x": 980.0, "y": 1631.3212465937106, "rotation": 0, "index": "b2D", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://en.wikipedia.org/wiki/Ferry_Tales", "w": 420.0, "h": 181.5, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ferry Tales (Katja Esson, 2003)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Oscar-nominated short: conversations in the Staten Island Ferry powder room — the ferry as accidental confessional."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://en.wikipedia.org/wiki/Ferry_Tales", "marks": [{"type": "link", "attrs": {"href": "https://en.wikipedia.org/wiki/Ferry_Tales", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:xWShnaugRW9mcUz5yte6F", "typeName": "shape", "type": "geo", "x": 520.0, "y": 1655.621246593711, "rotation": 0, "index": "b2E", "parentId": "shape:w3pijjKXjFJIzHadAoUoZ", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 230.10000000000002, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "yellow", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Shooting rules", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Camera grammar: locked-off wides, 1-point corridors, long takes at 3–4× real time of nothing happening; occasional telephoto of the hull wordmark sliding past (cf. Sealink 1982). Sound always 'on board' — never score over silence."}]}]}}, "meta": {}}, {"id": "shape:BBVZDlz3zOICJpI1ew28a", "typeName": "shape", "type": "frame", "x": 0.0, "y": 8242.954523700875, "rotation": 0, "index": "b2F", "parentId": "page:moodboard", "isLocked": false, "opacity": 1, "props": {"w": 1460.0, "h": 1114.2, "name": "Theatre & Set Design", "color": "black"}, "meta": {"zone": "Theatre & Set Design"}}, {"id": "shape:sHYhTe6bSwlyFzhGs7xAo", "typeName": "shape", "type": "image", "x": 60.0, "y": 60.0, "rotation": 0, "index": "b2G", "parentId": "shape:BBVZDlz3zOICJpI1ew28a", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 310.8, "playing": true, "url": "https://commons.wikimedia.org/wiki/File:TV-009-0416_(15052525776).jpg", "assetId": "asset:MN0DisSTmNOObBuLuhPrX", "crop": null, "flipX": false, "flipY": false, "altText": "Found set #1: Smallwood cafeteria — exactly the Viebrock register (fixed seating, fluorescent ceiling, beige)."}, "meta": {}}, {"id": "shape:8tOZyUrgcB2mBVrjGA63o", "typeName": "shape", "type": "text", "x": 60.0, "y": 378.8, "rotation": 0, "index": "b2H", "parentId": "shape:BBVZDlz3zOICJpI1ew28a", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Found set #1: Smallwood cafeteria — exactly the Viebrock re