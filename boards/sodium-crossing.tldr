ps://commons.wikimedia.org/wiki/File:Interi%C3%B6r,_Stena_Danica,_cafe,_taste,_20230410,_pic_01.jpg", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:93AjrFFllNLv9NczWtQas", "typeName": "shape", "type": "image", "x": 980.0, "y": 2086.8999999999996, "rotation": 0, "index": "b0B", "parentId": "shape:oU6Uu2uo4NQP8D0R1BSJt", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 281.1, "playing": true, "url": "https://commons.wikimedia.org/wiki/File:Restaurant_SunflowerGold_20071215.jpg", "assetId": "asset:yIJ27EBM9vGYkt8ZFg3QY", "crop": null, "flipX": false, "flipY": false, "altText": "Restaurant entrance on the Japanese ferry Sunflower Gold (Diamond Ferry), 2007."}, "meta": {}}, {"id": "shape:0KPmEIqOG9JzhjVggkGZM", "typeName": "shape", "type": "text", "x": 980.0, "y": 2375.9999999999995, "rotation": 0, "index": "b0C", "parentId": "shape:oU6Uu2uo4NQP8D0R1BSJt", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Restaurant entrance on the Japanese ferry Sunflower Gold (Diamond Ferry), 2007."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Olegushka · CC0 · via Wikimedia Commons"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Source: "}, {"type": "text", "text": "https://commons.wikimedia.org/wiki/File:Restaurant_SunflowerGold_20071215.jpg", "marks": [{"type": "link", "attrs": {"href": "https://commons.wikimedia.org/wiki/File:Restaurant_SunflowerGold_20071215.jpg", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:pc50t3YsL7E6pySnt2EXp", "typeName": "shape", "type": "image", "x": 520.0, "y": 2125.0928934010153, "rotation": 0, "index": "b0D", "parentId": "shape:oU6Uu2uo4NQP8D0R1BSJt", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 315.0, "playing": true, "url": "https://commons.wikimedia.org/wiki/File:Sunflower_Sapporo_promenade.jpg", "assetId": "asset:YdaVuSvkqg4KvBxd3K7BM", "crop": null, "flipX": false, "flipY": false, "altText": "Sunflower Sapporo, 6th-floor promenade (2025): the Japanese long-distance ferry as indoor street."}, "meta": {}}, {"id": "shape:kwl8sIhHxyehZvplrocPv", "typeName": "shape", "type": "text", "x": 520.0, "y": 2448.0928934010153, "rotation": 0, "index": "b0E", "parentId": "shape:oU6Uu2uo4NQP8D0R1BSJt", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sunflower Sapporo, 6th-floor promenade (2025): the Japanese long-distance ferry as indoor street."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Totti · CC BY-SA 4.0 · via Wikimedia Commons"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Source: "}, {"type": "text", "text": "https://commons.wikimedia.org/wiki/File:Sunflower_Sapporo_promenade.jpg", "marks": [{"type": "link", "attrs": {"href": "https://commons.wikimedia.org/wiki/File:Sunflower_Sapporo_promenade.jpg", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:q3KwpLn2hFHqVxOJtyfk0", "typeName": "shape", "type": "image", "x": 60.0, "y": 2196.3999999999996, "rotation": 0, "index": "b0F", "parentId": "shape:oU6Uu2uo4NQP8D0R1BSJt", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 315.0, "playing": true, "url": "https://commons.wikimedia.org/wiki/File:Business_Lounge_on_Tallink_MyStar_Ferry_from_Helsinki_to_Tallinn_(53928790508).jpg", "assetId": "asset:jRfqZhBZXjvSx7m6FoCiR", "crop": null, "flipX": false, "flipY": false, "altText": "Business lounge, Tallink MyStar (Helsinki–Tallinn, 2024). Contemporary calm we want to roughen."}, "meta": {}}, {"id": "shape:tPgIwFsetohSrz4W21irb", "typeName": "shape", "type": "text", "x": 60.0, "y": 2519.3999999999996, "rotation": 0, "index": "b0G", "parentId": "shape:oU6Uu2uo4NQP8D0R1BSJt", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Business lounge, Tallink MyStar (Helsinki–Tallinn, 2024). Contemporary calm we want to roughen."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Tony Webster · CC BY 2.0 · via Wikimedia Commons"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Source: "}, {"type": "text", "text": "https://commons.wikimedia.org/wiki/File:Business_Lounge_on_Tallink_MyStar_Ferry_from_Helsinki_to_Tallinn_(53928790508).jpg", "marks": [{"type": "link", "attrs": {"href": "https://commons.wikimedia.org/wiki/File:Business_Lounge_on_Tallink_MyStar_Ferry_from_Helsinki_to_Tallinn_(53928790508).jpg", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:QPvzORp0vMlh4TScckmsx", "typeName": "shape", "type": "frame", "x": 0.0, "y": 3405.0999999999995, "rotation": 0, "index": "b0H", "parentId": "page:moodboard", "isLocked": false, "opacity": 1, "props": {"w": 1460.0, "h": 2472.133277107164, "name": "Spatial Rules", "color": "black"}, "meta": {"zone": "Spatial Rules"}}, {"id": "shape:ctNl0JSpAQvaZWrc0Lcpg", "typeName": "shape", "type": "geo", "x": 60.0, "y": 60.0, "rotation": 0, "index": "b0I", "parentId": "shape:QPvzORp0vMlh4TScckmsx", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 205.8, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. One source per frame. Every image is lit by one dominant source — a sodium mast, a fluorescent strip, a vending machine — and everything else falls off into black."}]}]}}, "meta": {}}, {"id": "shape:Xn4UfRyUZrf6A5QTZMCdR", "typeName": "shape", "type": "geo", "x": 520.0, "y": 60.0, "rotation": 0, "index": "b0J", "parentId": "shape:QPvzORp0vMlh4TScckmsx", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 181.5, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2. Corridors run to a vanishing point. Use one-point perspective for interiors (cabin corridors, car decks): the ship is a set of tubes."}]}]}}, "meta": {}}, {"id": "shape:AF5hVcRXqH8NHpdwzmtiR", "typeName": "shape", "type": "geo", "x": 980.0, "y": 60.0, "rotation": 0, "index": "b0K", "parentId": "shape:QPvzORp0vMlh4TScckmsx", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 181.5, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3. Low ceilings, long floors. Frame car decks and lounges with the ceiling in shot; the horizontal is longer than the room deserves."}]}]}}, "meta": {}}, {"id": "shape:PooFB6vs2iIuYHVkPLCVZ", "typeName": "shape", "type": "geo", "x": 520.0, "y": 281.5, "rotation": 0, "index": "b0L", "parentId": "shape:QPvzORp0vMlh4TScckmsx", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 181.5, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4. Everything is fixed down. Chairs bolted, tables in rows, lashing points in the deck. Nothing in the composition floats free except people."}]}]}}, "meta": {}}, {"id": "shape:hrwmdrmRBhuDwkea9UfS8", "typeName": "shape", "type": "geo", "x": 980.0, "y": 281.5, "rotation": 0, "index": "b0M", "parentId": "shape:QPvzORp0vMlh4TScckmsx", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 181.5, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5. The threshold is sacred. Ramps, bow doors, gangways and muster stations are the hero spaces — moments of crossing from land-state to sea-state."}]}]}}, "meta": {}}, {"id": "shape:IgEAlHa5NM5OppibW0slN", "typeName": "shape", "type": "geo", "x": 60.0, "y": 305.8, "rotation": 0, "index": "b0N", "parentId": "shape:QPvzORp0vMlh4TScckmsx", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 157.2, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6. Occupancy under 10%. Rooms built for 1,000 shown with 1–6 people; empty seats carry the narrative."}]}]}}, "meta": {}}, {"id": "shape:05kWZUulZtwIwZocJMYR4", "typeName": "shape", "type": "geo", "x": 60.0, "y": 503.0, "rotation": 0, "index": "b0O", "parentId": "shape:QPvzORp0vMlh4TScckmsx", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 181.5, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7. Signage is architecture. Deck numbers, assembly-station boards and lane markings are composed as primary forms, not afterthoughts."}]}]}}, "meta": {}}, {"id": "shape:6EEjsKeQkB8fcBlSa01WA", "typeName": "shape", "type": "geo", "x": 520.0, "y": 503.0, "rotation": 0, "index": "b0P", "parentId": "shape:QPvzORp0vMlh4TScckmsx", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 181.5, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-blue", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8. The horizon is withheld. Exterior night shots show black water and harbour lights, rarely sky; the sea is felt as darkness and noise."}]}]}}, "meta": {}}, {"id": "shape:87MYdPLsJ7DOsv2blQBfO", "typeName": "shape", "type": "image", "x": 980.0, "y": 503.0, "rotation": 0, "index": "b0Q", "parentId": "shape:QPvzORp0vMlh4TScckmsx", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 630.225080385852, "playing": true, "url": "https://commons.wikimedia.org/wiki/File:MV_St._Francis_Xavier_-_assembly_station_No.1_-_Oct_2024.jpg", "assetId": "asset:rPFAuBPZ4ksBIvmfuC841", "crop": null, "flipX": false, "flipY": false, "altText": "Assembly station No.1 sign, MV St. Francis Xavier (2GO): the boat's most important typography."}, "meta": {}}, {"id": "