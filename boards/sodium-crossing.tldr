lign": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "DO light with one warm source and let black win."}]}]}}, "meta": {}}, {"id": "shape:XzvCT34VkwamvkDiOzpQu", "typeName": "shape", "type": "geo", "x": 520.0, "y": 60.0, "rotation": 0, "index": "b44", "parentId": "shape:FKEUHrGnaG1SmFKJCFQ2F", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-green", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "DO use real deck numbers, times and ports in every layout."}]}]}}, "meta": {}}, {"id": "shape:bZU2sqRj7OIdrA8iKe8UY", "typeName": "shape", "type": "geo", "x": 60.0, "y": 232.9, "rotation": 0, "index": "b45", "parentId": "shape:FKEUHrGnaG1SmFKJCFQ2F", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-green", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "DO photograph empty rooms built for crowds."}]}]}}, "meta": {}}, {"id": "shape:UlocIflk5Wr8jixXgWHXu", "typeName": "shape", "type": "geo", "x": 520.0, "y": 232.9, "rotation": 0, "index": "b46", "parentId": "shape:FKEUHrGnaG1SmFKJCFQ2F", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-green", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "DO keep safety red and wayfinding yellow functional, never decorative."}]}]}}, "meta": {}}, {"id": "shape:cgSFVmrn0RjScCpVSQmcN", "typeName": "shape", "type": "geo", "x": 60.0, "y": 405.8, "rotation": 0, "index": "b47", "parentId": "shape:FKEUHrGnaG1SmFKJCFQ2F", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-green", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "DO let sound be diegetic: engine, PA, chime, whistle."}]}]}}, "meta": {}}, {"id": "shape:RaZ3wGO5OFVEcHzuyntU2", "typeName": "shape", "type": "geo", "x": 520.0, "y": 405.8, "rotation": 0, "index": "b48", "parentId": "shape:FKEUHrGnaG1SmFKJCFQ2F", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 157.2, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-green", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "DO treat the Herald and Estonia with gravity — reference, never aestheticise disaster."}]}]}}, "meta": {}}, {"id": "shape:C0hFUWyk7LOvhJz3PUJUi", "typeName": "shape", "type": "geo", "x": 60.0, "y": 578.7, "rotation": 0, "index": "b49", "parentId": "shape:FKEUHrGnaG1SmFKJCFQ2F", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-red", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "DON'T do nautical kitsch: no anchors, rope fonts, Breton stripes, gulls."}]}]}}, "meta": {}}, {"id": "shape:9KLlfRTPpEVN4fWaMHezP", "typeName": "shape", "type": "geo", "x": 520.0, "y": 603.0, "rotation": 0, "index": "b4A", "parentId": "shape:FKEUHrGnaG1SmFKJCFQ2F", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-red", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "DON'T do 'vaporwave liminal' pastel grading — sodium is monochrome, not neon."}]}]}}, "meta": {}}, {"id": "shape:1eFXh36vmjnzR6I7AOazb", "typeName": "shape", "type": "geo", "x": 60.0, "y": 751.6, "rotation": 0, "index": "b4B", "parentId": "shape:FKEUHrGnaG1SmFKJCFQ2F", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-red", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "DON'T show sunny daytime decks or open-sea sunsets."}]}]}}, "meta": {}}, {"id": "shape:iYhsGGbgPzfDx9cleI7Wg", "typeName": "shape", "type": "geo", "x": 520.0, "y": 775.9, "rotation": 0, "index": "b4C", "parentId": "shape:FKEUHrGnaG1SmFKJCFQ2F", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 132.9, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "light-red", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "ric