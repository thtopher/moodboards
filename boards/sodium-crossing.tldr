{"tldrawFileFormatVersion": 1, "schema": {"schemaVersion": 2, "sequences": {"com.tldraw.store": 5, "com.tldraw.asset": 1, "com.tldraw.camera": 1, "com.tldraw.document": 2, "com.tldraw.instance": 26, "com.tldraw.instance_page_state": 5, "com.tldraw.page": 1, "com.tldraw.instance_presence": 6, "com.tldraw.pointer": 1, "com.tldraw.shape": 4, "com.tldraw.user": 1, "com.tldraw.asset.image": 6, "com.tldraw.asset.video": 5, "com.tldraw.asset.bookmark": 2, "com.tldraw.shape.arrow": 8, "com.tldraw.shape.bookmark": 2, "com.tldraw.shape.draw": 5, "com.tldraw.shape.embed": 4, "com.tldraw.shape.frame": 1, "com.tldraw.shape.geo": 12, "com.tldraw.shape.group": 0, "com.tldraw.shape.highlight": 4, "com.tldraw.shape.image": 5, "com.tldraw.shape.line": 5, "com.tldraw.shape.note": 13, "com.tldraw.shape.text": 4, "com.tldraw.shape.video": 4, "com.tldraw.binding.arrow": 1}}, "records": [{"id": "document:document", "typeName": "document", "gridSize": 10, "name": "SODIUM CROSSING", "meta": {}}, {"id": "page:moodboard", "typeName": "page", "name": "SODIUM CROSSING", "index": "a1", "meta": {}}, {"id": "asset:8yy6Skhj4YjZ8OvIia8OG", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 788, "name": "Long-exposure light trail of M/S Mecklenburg-Vorpommern leaving Rostock for Trelleborg — the crossing as a single drawn ", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 164712}, "meta": {}}, {"id": "asset:V4BLFFQCHD6R26qI60ihB", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 937, "name": "Frederikshavn harbour at night, seen from the ferry. Sodium quay, black water, a city you are leaving.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 253331}, "meta": {}}, {"id": "asset:A4Yqj4JRfdQAe6NXf1e1C", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 934, "name": "Makasiiniterminaali, Helsinki, at night: an empty sodium apron. The terminal as stage before the actors arrive.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 253112}, "meta": {}}, {"id": "asset:ieTpkf01PrpsCjBq78Hp7", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 788, "name": "A late walk at Howth, Ireland: harbour lamps on a wet pier.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 113726}, "meta": {}}, {"id": "asset:QQobiwgZIMMQEaXUFHOeT", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 933, "name": "A high-pressure sodium bulb inside a street lamp. The source itself: a hot amber filament-like arc tube.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 238050}, "meta": {}}, {"id": "asset:6nKiG7iYF2Ro3EbaEBsiv", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Towards Helsinki's Länsiterminaali at about 02:15 local time — the hour this board lives in.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 203182}, "meta": {}}, {"id": "asset:5hDvsT8qOsIykkm4En49B", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 556, "name": "Preemraff Lysekil refinery on a foggy night — industrial coast as a field of point sources in haze.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 44501}, "meta": {}}, {"id": "asset:pgjGQ6SOVCIcWo5OshpNR", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 928, "name": "Upper deck at night, Ancona–Patras ferry. The ship's own floodlights are cold blue LED: the new night that is replacing ", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 240818}, "meta": {}}, {"id": "asset:s7ElnzP6jyn8iddy32T95", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 928, "name": "Same deck, Ancona–Patras: wet railings, blue-white light, nobody aboard the frame.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 194358}, "meta": {}}, {"id": "asset:MqStraU4N6boD77xpAE5l", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 774, "name": "Illuminated ferry docked at Punta de Piedras, Venezuela, reflected in black water.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 218817}, "meta": {}}, {"id": "asset:j2Juy9FoYO9gDY04cshl8", "typeName": "asset", "type": "image", "props": {"w": 927, "h": 1400, "name": "Port of Rotterdam by night, 2014.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 169122}, "meta": {}}, {"id": "asset:z19wmTma3AYz2CkaIN4fM", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 933, "name": "Snow falling through a sodium lamp, Tuntorp, Sweden. Particles made visible by a single orange source.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 335657}, "meta": {}}, {"id": "asset:LIMsAKAOBBbMEoVWClDgh", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 933, "name": "Sodium-vapor glow, Great Holm, Milton Keynes — the reference orange: a monochrome street where every colour falls into a", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 320250}, "meta": {}}, {"id": "asset:lj6Q3kWhGNw2IJ2g9NyXq", "typeName": "asset", "type": "image", "props": {"w": 640, "h": 481, "name": "Stena HSS idling in Holyhead's Inner Harbour (2009) — the late-90s fast-craft era, already being cut back.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 47954}, "meta": {}}, {"id": "asset:2WyqaNIvOB6Tp4cGzodWa", "typeName": "asset", "type": "image", "props": {"w": 1024, "h": 439, "name": "Stena Scotia on Albert Quay, Belfast, night view (2019). Hull as lightbox.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 59729}, "meta": {}}, {"id": "asset:3e146gmgc0YNZNrggUmtA", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Cabin corridor, Brittany Ferries Baie de Seine, Bay of Biscay (2017).", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 209957}, "meta": {}}, {"id": "asset:fWRWMwyy3f3bmq3Fx2oCG", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Superior cabin corridor aboard Ferry Kyoto (2023): perspective, handrail, identical doors.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 224815}, "meta": {}}, {"id": "asset:mycyXQFNCiLzT4AJUAoS2", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 928, "name": "Second-class room on Ferry Mishima (Sakito Shosen), 2017: carpet, bolsters, a clock.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 139165}, "meta": {}}, {"id": "asset:nQyVh9wdryazARvqnT6Gn", "typeName": "asset", "type": "image", "props": {"w": 800, "h": 539, "name": "Entrance to the Buffet Helsinki restaurant aboard GTS Finnjet, 2004 (photo scanned by Kalle Id): late-70s ship interiors", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 91020}, "meta": {}}, {"id": "asset:WiZNaa7OpgioWvj4Xk3LW", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Hankyu Ferry second-class room: shared floor, folded blanket, a bag of snacks. The tatami-style communal night.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 278753}, "meta": {}}, {"id": "asset:3cSMu1wDGVnAAIZsZzFqF", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Forward bar, MV Isle of Arran (CalMac): wood, red upholstery, a Scottish 1980s ferry interior still in service in 2017.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 184825}, "meta": {}}, {"id": "asset:psAtAN5dJchYJ4BayK68D", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1054, "name": "Blue Note Bar, deck 9, MV Mont St Michel: patterned carpet, red upholstery, a lounge waiting for its band.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 359435}, "meta": {}}, {"id": "asset:wJBPiXwNNzxW6WJsd8RZu", "typeName": "asset", "type": "image", "props": {"w": 1054, "h": 1400, "name": "La Galerie self-service restaurant, deck 8, MV Mont St Michel (Brittany Ferries). Rows of tables built for a rush that i", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 182887}, "meta": {}}, {"id": "asset:UXCfYVoJ32GDKlllRwIyG", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Information desk on the New Taima ferry (Matsu–Taiwan), screen showing live ship position on OpenStreetMap.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 218167}, "meta": {}}, {"id": "asset:N7PyBj79ncpv34ZcWRO9d", "typeName": "asset", "type": "image", "props": {"w": 788, "h": 1400, "name": "Ocean Tokyu Ferry 2nd-class western berths: curtains turn a dorm into private cells.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 98312}, "meta": {}}, {"id": "asset:1qzjq0ukEt3h8d3PnDrpm", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 933, "name": "Silja Festival cabin: the minimum unit of sleep between countries.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 152295}, "meta": {}}, {"id": "asset:SdYu01Ea4D2qlZwkxKaGB", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 928, "name": "Silja Galaxy interior (2019): brass, veneer, carpet — the cruiseferry's hotel-lobby dream.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 223337}, "meta": {}}, {"id": "asset:iK1jJUkZ6yA0Gy6WuouB8", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 928, "name": "Silja Galaxy interior detail.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 194820}, "meta": {}}, {"id": "asset:7FqCHjhiszrpfH0LJOmSC", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1054, "name": "Stena Danica, deck seven (2023): wayfinding panels, long linear ceilings.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 310215}, "meta": {}}, {"id": "asset:DWR4h1aVKE7JzW2LxCCSs", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1054, "name": "Entrance to Café Danica and through-route to the Taste buffet: red columns, glossy floor, signage.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 319467}, "meta": {}}, {"id": "asset:yIJ27EBM9vGYkt8ZFg3QY", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 937, "name": "Restaurant entrance on the Japanese ferry Sunflower Gold (Diamond Ferry), 2007.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 203069}, "meta": {}}, {"id": "asset:YdaVuSvkqg4KvBxd3K7BM", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Sunflower Sapporo, 6th-floor promenade (2025): the Japanese long-distance ferry as indoor street.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 324016}, "meta": {}}, {"id": "asset:jRfqZhBZXjvSx7m6FoCiR", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Business lounge, Tallink MyStar (Helsinki–Tallinn, 2024). Contemporary calm we want to roughen.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 373204}, "meta": {}}, {"id": "asset:rPFAuBPZ4ksBIvmfuC841", "typeName": "asset", "type": "image", "props": {"w": 933, "h": 1400, "name": "Assembly station No.1 sign, MV St. Francis Xavier (2GO): the boat's most important typography.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 103313}, "meta": {}}, {"id": "asset:FKezeB1ISUh9SgZyk7IWi", "typeName": "asset", "type": "image", "props": {"w": 933, "h": 1400, "name": "Engine room of the Bergama ferry (Istanbul): the machine the passengers never see but always hear.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 111631}, "meta": {}}, {"id": "asset:gXlIrQxi2HQY6avjF2Xcl", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Car deck, Corran Ferry (Scotland, 2025): open deck, yellow lining, hills beyond.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 255819}, "meta": {}}, {"id": "asset:WNNwrX26QsVTFNvIzduu9", "typeName": "asset", "type": "image", "props": {"w": 1121, "h": 1400, "name": "Red lifebuoy and floodlight on white railing, Blue Star Myconos: the three-colour kit of every deck.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 243081}, "meta": {}}, {"id": "asset:L1OmT7LeY2vilH2N5nuUO", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Night Ferry carriage boards, London–Paris–Brussels (National Railway Museum, York). Blue enamel, yellow serif caps, cres", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 224728}, "meta": {}}, {"id": "asset:rG6iaDOVw9oUfbidFIl6w", "typeName": "asset", "type": "image", "props": {"w": 427, "h": 640, "name": "Car deck of the M/V Norsky (Hull–Rotterdam freight ferry), 2009: lane lines, lashing points, low ceiling, deep perspecti", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 60151}, "meta": {}}, {"id": "asset:1qUZruE3kQLCJ2n2wW1l1", "typeName": "asset", "type": "image", "props": {"w": 640, "h": 427, "name": "Ro-ro stern ramp of the Hoegh Osaka at Southampton berth 101 (2015). The threshold between land and ship.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 48570}, "meta": {}}, {"id": "asset:h0W4dRuOIt8aU0FK9oNUx", "typeName": "asset", "type": "image", "props": {"w": 240, "h": 240, "name": "swatch #100B0B", "isAnimated": false, "mimeType": "image/png", "src": "data:image/png;base64,", "fileSize": 524}, "meta": {}}, {"id": "asset:Cfy9RBDXVjQwGowvxbmJd", "typeName": "asset", "type": "image", "props": {"w": 240, "h": 240, "name": "swatch #E4A10A", "isAnimated": false, "mimeType": "image/png", "src": "data:image/png;base64,", "fileSize": 527}, "meta": {}}, {"id": "asset:C0zD3BEFZPTycQIVVhneY", "typeName": "asset", "type": "image", "props": {"w": 240, "h": 240, "name": "swatch #B35F0A", "isAnimated": false, "mimeType": "image/png", "src": "data:image/png;base64,", "fileSize": 526}, "meta": {}}, {"id": "asset:Xm5IdtHzJuqXsSXKC5B2d", "typeName": "asset", "type": "image", "props": {"w": 240, "h": 240, "name": "swatch #583112", "isAnimated": false, "mimeType": "image/png", "src": "data:image/png;base64,", "fileSize": 527}, "meta": {}}, {"id": "asset:jX8ycxNnHfCTAQhZh596G", "typeName": "asset", "type": "image", "props": {"w": 240, "h": 240, "name": "swatch #6F665F", "isAnimated": false, "mimeType": "image/png", "src": "data:image/png;base64,", "fileSize": 526}, "meta": {}}, {"id": "asset:iJvxPkk6u02Djf2hEHhDk", "typeName": "asset", "type": "image", "props": {"w": 240, "h": 240, "name": "swatch #C0A889", "isAnimated": false, "mimeType": "image/png", "src": "data:image/png;base64,", "fileSize": 526}, "meta": {}}, {"id": "asset:C5a6zzfpTQjvimnu89XDE", "typeName": "asset", "type": "image", "props": {"w": 240, "h": 240, "name": "swatch #104B97", "isAnimated": false, "mimeType": "image/png", "src": "data:image/png;base64,", "fileSize": 526}, "meta": {}}, {"id": "asset:QSyWXQ6ZzfOZvKZXaEbgY", "typeName": "asset", "type": "image", "props": {"w": 240, "h": 240, "name": "swatch #E7E8E8", "isAnimated": false, "mimeType": "image/png", "src": "data:image/png;base64,", "fileSize": 523}, "meta": {}}, {"id": "asset:vgI1Fx53PeMB7wONxGP4E", "typeName": "asset", "type": "image", "props": {"w": 240, "h": 240, "name": "swatch #A72A21", "isAnimated": false, "mimeType": "image/png", "src": "data:image/png;base64,", "fileSize": 526}, "meta": {}}, {"id": "asset:iF2kTktdsx77lt6mtBgqy", "typeName": "asset", "type": "image", "props": {"w": 240, "h": 240, "name": "swatch #BCBD17", "isAnimated": false, "mimeType": "image/png", "src": "data:image/png;base64,", "fileSize": 526}, "meta": {}}, {"id": "asset:dBIYcZgnNvuJnXm0YHbWb", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 613, "name": "Overpass (Delve Fonts) — open-source interpretation of US 'Highway Gothic' road-sign letterforms. Our deck numbers and c", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 48537}, "meta": {}}, {"id": "asset:Sdma1SNqwkN9sckw3XCgg", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 613, "name": "Barlow Condensed — Jeremy Tribby; 'drawing from the visual style of the California public… car plates, highway signs, bu", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 51161}, "meta": {}}, {"id": "asset:mp4xgKhmCKNRBeSdDyPSo", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 613, "name": "IBM Plex Mono — the manifest/ticket voice: boarding cards, vehicle registrations, cabin numbers, departure times.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 49671}, "meta": {}}, {"id": "asset:4a0IYFMKXedHsyaUbZYCh", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 613, "name": "B612 — Airbus/ENAC face designed for cockpit screens and 'degraded contexts'. The bridge-instrument voice: headings, spe", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 57982}, "meta": {}}, {"id": "asset:BRpsvufB8O5VZ9Urpzbo2", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 613, "name": "DotGothic16 (Fontworks) — 16×16 bitmap gothic. Japanese overnight-ferry departure boards and LED tickers.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 57773}, "meta": {}}, {"id": "asset:q7NKOLRsdeawigE8QqVlg", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 613, "name": "VT323 — from the DEC VT320 terminal's glyphs, CRT smear included. Duty-free tills, cabin TV info channel, receipts.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 50898}, "meta": {}}, {"id": "asset:GgpXrxVnmnxwND1dPZobB", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 613, "name": "Archivo Narrow (Omnibus-Type) — late-19th-century American grotesque lineage; our editorial/narrative text face.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 55595}, "meta": {}}, {"id": "asset:DlaOFbDTHoELOiX6T1w3l", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 613, "name": "Noto Sans JP — Japanese wayfinding companion for bilingual safety notices (車両甲板 = car deck).", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 48455}, "meta": {}}, {"id": "asset:eUVBfyf7drVigekGZkkVA", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 917, "name": "Mooring line lashed on a bollard, Gunnar Thorson, Lysekil.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 158166}, "meta": {}}, {"id": "asset:u0Yqwxvxgo4zN3Up5X9TU", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 898, "name": "Townsend Thoresen car ferries enamel souvenir badge, bought on board.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 309444}, "meta": {}}, {"id": "asset:tN3D3Tt2JgKZGEz2Pmww7", "typeName": "asset", "type": "image", "props": {"w": 688, "h": 368, "name": "Sealink ticket for one accompanied bicycle, Dún Laoghaire–Holyhead, 16 August 1986.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 47902}, "meta": {}}, {"id": "asset:dqTS46I5f5AlU1xf2UL8c", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 961, "name": "Crew in safety gear at a ferry ramp as vehicles board (Uganda). Hi-vis as the uniform of thresholds.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 204869}, "meta": {}}, {"id": "asset:kxQaXWFaXzPJTz775Mtxq", "typeName": "asset", "type": "image", "props": {"w": 1396, "h": 1100, "name": "Lewis Hine, Stevedores on a New York dock, c.1912: caps, braces, rolled sleeves — the dockside ancestor of crew wear.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 268901}, "meta": {}}, {"id": "asset:w569AJYVC1y6DhUiQd9HT", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1136, "name": "Star Ferry crew mooring with a billhook, Hong Kong (2013): sailor whites, work gloves, rope.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 340061}, "meta": {}}, {"id": "asset:F6pjsu4RAkch0OjMdFugU", "typeName": "asset", "type": "image", "props": {"w": 854, "h": 480, "name": "Sealink (British Rail) TV advert, 1982, at ~0:02 — yachtswoman Clare Francis MBE in red foul-weather gear: the brand bor", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 31416}, "meta": {}}, {"id": "asset:RJ8cSXgtdKSvRwSr8BafT", "typeName": "asset", "type": "image", "props": {"w": 854, "h": 480, "name": "Same advert, ~0:12 — the SEALINK hull wordmark sliding past a sail. Scale contrast: ferry as moving wall.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 30427}, "meta": {}}, {"id": "asset:p5FxsyRYDTnCwswUTmoWO", "typeName": "asset", "type": "image", "props": {"w": 854, "h": 480, "name": "Same advert, ~0:14 — the ferry crossing frame, dinghy in foreground.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 31112}, "meta": {}}, {"id": "asset:3ByKpbyxaxVuQMlbPLsm1", "typeName": "asset", "type": "image", "props": {"w": 758, "h": 576, "name": "Sealink British Ferries 'Doubletake' advert, 1988, ~0:01 — a telephoto ferry on a flat sea; video-tape blue.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 34866}, "meta": {}}, {"id": "asset:B9fCnaffwAFrRF8kFEx1m", "typeName": "asset", "type": "image", "props": {"w": 758, "h": 576, "name": "Doubletake, ~0:17 — the end card: italic SEALINK DOUBLETAKE super over the ship, small-print offer terms. Halfway throug", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 41258}, "meta": {}}, {"id": "asset:MN0DisSTmNOObBuLuhPrX", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1036, "name": "Found set #1: Smallwood cafeteria — exactly the Viebrock register (fixed seating, fluorescent ceiling, beige).", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 285518}, "meta": {}}, {"id": "asset:IzcB4sKSd5gsSbxhDajnf", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1050, "name": "Found set #2: vending wall, Fanafjord ferry.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 258906}, "meta": {}}, {"id": "asset:8396pYLm9OYIe1kqMmCSf", "typeName": "asset", "type": "image", "props": {"w": 800, "h": 534, "name": "Found set #3: lit ferry waiting room at night, Belmont, Shetland — a box stage.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 41996}, "meta": {}}, {"id": "asset:9muafdAZR7ZKJaxqMeHxE", "typeName": "asset", "type": "image", "props": {"w": 1000, "h": 636, "name": "John Atkinson Grimshaw, Liverpool Docks by Night, 1892: gas-lit wet quays, the Victorian sodium.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 114880}, "meta": {}}, {"id": "asset:t2dWbOXoxoRGLuK7W7pFx", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1052, "name": "J.M.W. Turner, Snow Storm – Steam-Boat off a Harbour's Mouth, c.1842. The crossing as vortex.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 308820}, "meta": {}}, {"id": "asset:Z5tQQ0JrpHi13pRPhWVsg", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 925, "name": "James McNeill Whistler, Nocturne: Blue and Gold—Southampton Water, 1872 (Art Institute of Chicago). Ships reduced to poi", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 273600}, "meta": {}}, {"id": "asset:H09VHSN78VnJBoWnSEARS", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 892, "name": "GTS Finnjet at Travemünde, 1987. Gas-turbine powered; at delivery in 1977 the fastest, longest and largest car ferry in ", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 326172}, "meta": {}}, {"id": "asset:NKZuc7HKeUxNr4wr3nqE8", "typeName": "asset", "type": "image", "props": {"w": 1164, "h": 733, "name": "Herald of Free Enterprise at Dover Eastern Docks, 1984 — Townsend Thoresen red hull. Capsized off Zeebrugge, 6 March 198", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 116369}, "meta": {}}, {"id": "asset:CDiSHtZ659eyBpU4iF73B", "typeName": "asset", "type": "image", "props": {"w": 640, "h": 288, "name": "Holyhead Ferry 1 at Dún Laoghaire, March 1975.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 59581}, "meta": {}}, {"id": "asset:VD9LhniLM1aa8qq1gX3IL", "typeName": "asset", "type": "image", "props": {"w": 640, "h": 391, "name": "Ionic Ferry departing Larne for Cairnryan, August 1986.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 64434}, "meta": {}}, {"id": "asset:EwpZ36peNb1QuBQjwWQKg", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 1041, "name": "Shin Nihonkai Ferry's New Akashia, 2004 — Sea of Japan overnight route.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 382303}, "meta": {}}, {"id": "asset:fCYvi1RadI7M2gJlujCcO", "typeName": "asset", "type": "image", "props": {"w": 640, "h": 408, "name": "Sealink ferry at Folkestone Harbour Pier, 1979.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 34806}, "meta": {}}, {"id": "asset:lRht0JFSExIbvc94Oj1rX", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 906, "name": "Cars queueing for Sealink's St Brendan, Fishguard–Rosslare, August 1987.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 249762}, "meta": {}}, {"id": "asset:1e6OyALG13uaWOOee3wD8", "typeName": "asset", "type": "image", "props": {"w": 1400, "h": 933, "name": "A Townsend Thoresen ferry leaves port, 1981.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 236418}, "meta": {}}, {"id": "asset:FXAd5i2cOjqAUAzyGr7li", "typeName": "asset", "type": "image", "props": {"w": 1200, "h": 806, "name": "MS Viking Sally, 1980 (Bo Palmqvist). Later Silja Star, Wasa King, and from 1993 MS Estonia, lost 28 September 1994 betw", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 149478}, "meta": {}}, {"id": "asset:fw6xNfV1xxFpnhQF7726Z", "typeName": "asset", "type": "image", "props": {"w": 916, "h": 1400, "name": "Silja Line Tax Free catalogue 1995–96, cover: a cornucopia of bottles under the red TAX FREE flag.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 287880}, "meta": {}}, {"id": "asset:AFc2Jvrl50xLImcTkJbbk", "typeName": "asset", "type": "image", "props": {"w": 899, "h": 1400, "name": "Catalogue p.10: spirits shot like jewellery, with price columns in two currencies.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 219344}, "meta": {}}, {"id": "asset:OH2baCg0f2niUQzKI6FHC", "typeName": "asset", "type": "image", "props": {"w": 886, "h": 1400, "name": "Catalogue p.40: champagne page — the duty-free night as aspiration.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 156662}, "meta": {}}, {"id": "asset:0GcqFks4BoLgGOfItUM4L", "typeName": "asset", "type": "image", "props": {"w": 870, "h": 1400, "name": "Catalogue p.60: 'BONUS' — the uploader notes tax-free sales ended in 1999.", "isAnimated": false, "mimeType": "image/jpeg", "src": "data:image/jpeg;base64,", "fileSize": 149396}, "meta": {}}, {"id": "shape:ujOeHwdFcAefAZhnM6Jy8", "typeName": "shape", "type": "text", "x": 0.0, "y": 0.0, "rotation": 0, "index": "a1", "parentId": "page:moodboard", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "xl", "font": "serif", "textAlign": "start", "w": 1800.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "SODIUM CROSSING"}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:c1rihtYlKNxHddmQAtKCs", "typeName": "shape", "type": "text", "x": 0.0, "y": 90.0, "rotation": 0, "index": "a2", "parentId": "page:moodboard", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "m", "font": "serif", "textAlign": "start", "w": 1800.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The overnight car ferry is a stateless room lit by a colour that no longer exists: low-pressure sodium, whose last lamps were made in Scotland on 31 December 2019. Between two countries, after the duty-free shutters fall, a few hundred strangers share fluorescent cafeterias, humming corridors and orange-washed steel decks. Sodium Crossing treats that night as both procedure and elegy — wayfinding, safety drills and engine drone, staged with the tenderness of something about to disappear."}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:XRpJG2Tr8hzUjEcPVJ2tR", "typeName": "shape", "type": "text", "x": 0.0, "y": 247.60000000000002, "rotation": 0, "index": "a3", "parentId": "page:moodboard", "isLocked": false, "opacity": 1, "props": {"color": "grey", "size": "s", "font": "mono", "textAlign": "start", "w": 1800.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Keywords: sodium monochrome · stateless night · procedural tenderness · car-deck geometry · 3am cafeteria · duty-free afterglow · elegy for a light source · between two countries   |   World-building board — overnight car ferries, 1970s–now"}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:KJC06DPdRO9YrxPbCkhdV", "typeName": "shape", "type": "frame", "x": 0.0, "y": 417.6, "rotation": 0, "index": "a4", "parentId": "page:moodboard", "isLocked": false, "opacity": 1, "props": {"w": 1000.0, "h": 858.9000000000001, "name": "Thesis", "color": "black"}, "meta": {"zone": "Thesis"}}, {"id": "shape:ipy2eBI2Y1rzw27jkooEK", "typeName": "shape", "type": "geo", "x": 60.0, "y": 60.0, "rotation": 0, "index": "a5", "parentId": "shape:KJC06DPdRO9YrxPbCkhdV", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 375.90000000000003, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "orange", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Thesis", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The overnight car ferry is a stateless room lit by a colour that no longer exists: low-pressure sodium, whose last lamps were made in Scotland on 31 December 2019. Between two countries, after the duty-free shutters fall, a few hundred strangers share fluorescent cafeterias, humming corridors and orange-washed steel decks. Sodium Crossing treats that night as both procedure and elegy — wayfinding, safety drills and engine drone, staged with the tenderness of something about to disappear."}]}]}}, "meta": {}}, {"id": "shape:qazwJ7QFMPd3W2XyygNde", "typeName": "shape", "type": "geo", "x": 520.0, "y": 60.0, "rotation": 0, "index": "a6", "parentId": "shape:KJC06DPdRO9YrxPbCkhdV", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "", "w": 420.0, "h": 205.8, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "orange", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Keywords", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "sodium monochrome · stateless night · procedural tenderness · car-deck geometry · 3am cafeteria · duty-free afterglow · elegy for a light source · between two countries"}]}]}}, "meta": {}}, {"id": "shape:mkvdajgwb2Mjpvwh09CDf", "typeName": "shape", "type": "geo", "x": 520.0, "y": 305.8, "rotation": 0, "index": "a7", "parentId": "shape:KJC06DPdRO9YrxPbCkhdV", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://en.wikipedia.org/wiki/Sodium-vapor_lamp", "w": 420.0, "h": 303.0, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "orange", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why sodium", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Low-pressure sodium emits almost only 589.0/589.6 nm: under it colour vanishes (a red car reads black). The last LPS lamps were made at Philips, Hamilton, Scotland on 31 Dec 2019; LED is replacing sodium everywhere — including on ferry decks. — Wikipedia"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://en.wikipedia.org/wiki/Sodium-vapor_lamp", "marks": [{"type": "link", "attrs": {"href": "https://en.wikipedia.org/wiki/Sodium-vapor_lamp", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:gvqZkb6GjHbG81RqwkVHW", "typeName": "shape", "type": "geo", "x": 60.0, "y": 475.90000000000003, "rotation": 0, "index": "a8", "parentId": "shape:KJC06DPdRO9YrxPbCkhdV", "isLocked": false, "opacity": 1, "props": {"geo": "rectangle", "dash": "solid", "url": "https://en.wikipedia.org/wiki/Duty-free_shop", "w": 420.0, "h": 303.0, "growY": 0, "scale": 1, "flipX": false, "flipY": false, "labelColor": "black", "color": "orange", "fill": "semi", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why 'between two countries'", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Duty-free began at Shannon in 1947, was abolished on intra-EU routes in 1999 (Åland, outside the EU tax union, kept the Baltic ferries' shops alive), and returned on UK routes after Brexit in 2021. The ferry night is literally a tax-free, between-jurisdictions space. — Wikipedia"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "https://en.wikipedia.org/wiki/Duty-free_shop", "marks": [{"type": "link", "attrs": {"href": "https://en.wikipedia.org/wiki/Duty-free_shop", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null}}]}]}]}}, "meta": {}}, {"id": "shape:unY90XYToGwbbrqQ7B697", "typeName": "shape", "type": "frame", "x": 1620.0, "y": 417.6, "rotation": 0, "index": "a9", "parentId": "page:moodboard", "isLocked": false, "opacity": 1, "props": {"w": 1920.0, "h": 2116.1585937500004, "name": "Imagery: Light & Atmosphere", "color": "orange"}, "meta": {"zone": "Imagery: Light & Atmosphere"}}, {"id": "shape:wnommM30DOXfO4WUDlWuX", "typeName": "shape", "type": "text", "x": 60.0, "y": 60.0, "rotation": 0, "index": "aA", "parentId": "shape:unY90XYToGwbbrqQ7B697", "isLocked": false, "opacity": 1, "props": {"color": "grey", "size": "s", "font": "sans", "textAlign": "start", "w": 1800.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sodium vs. LED: one warm source, black water. All Wikimedia Commons, credited per card."}]}]}, "scale": 1, "autoSize": false}, "meta": {}}, {"id": "shape:5A2ZnpsoKqzi4vCK4A4FG", "typeName": "shape", "type": "image", "x": 60.0, "y": 112.3, "rotation": 0, "index": "aB", "parentId": "shape:unY90XYToGwbbrqQ7B697", "isLocked": false, "opacity": 1, "props": {"w": 420.0, "h": 236.4, "playing": true, "url": "https://commons.wikimedia.org/wiki/File:Ferry_light_trail,_Rostock.jpg", "assetId": "asset:8yy6Skhj4YjZ8OvIia8OG", "crop": null, "flipX": false, "flipY": false, "altText": "Long-exposure light trail of M/S Mecklenburg-Vorpommern leaving Rostock for Trelleborg — the crossing as a single drawn line."}, "meta": {}}, {"id": "shape:GbBlaXkDSIuGIWgIprVFI", "typeName": "shape", "type": "text", "x": 60.0, "y": 356.7, "rotation": 0, "index": "aC", "parentId": "shape:unY90XYToGwbbrqQ7B697", "isLocked": false, "opacity": 1, "props": {"color": "black", "size": "s", "font": "sans", "textAlign": "start", "w": 420.0, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Long-exposure light trail of M/S Mecklenburg-Vorpommern leaving Rostock for Trelleborg — the cr